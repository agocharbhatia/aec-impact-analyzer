{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structured.ai/schemas/element.schema.json",
  "title": "Element",
  "type": "object",
  "required": ["id", "discipline", "category", "level", "bbox"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "discipline": {
      "type": "string",
      "enum": ["ARCH", "MECH", "ELEC", "PLUMB"]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "string",
      "minLength": 1
    },
    "bbox": {
      "type": "object",
      "required": ["x1", "y1", "x2", "y2"],
      "properties": {
        "x1": { "type": "number" },
        "y1": { "type": "number" },
        "x2": { "type": "number" },
        "y2": { "type": "number" }
      },
      "additionalProperties": false
    },
    "connectors": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "params": {
      "type": "object",
      "default": {},
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
